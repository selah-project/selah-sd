{"tier":"glm-5.2","verse":19,"ref":"2-kings 10:19","book":"2-kings","lang":"sd","chapter":10,"translation":"۽ هاڻي بعل جي سڀني نبين کي، سندس سڀني ٻانهن کي ۽ سندس سڀني ڪاهنن کي مون ڏانهن سڏيو؛ هڪ به ماڻهو ڪونه رهي، ڇوته بعل لاءِ مان لاءِ وڏو قربان آهي؛ جيڪو به ڪونه ايندو سو جيئرو نه رهندو. پر ييهو چال سان ڪري رهيو هو، ۽ بعل جي ٻانهن کي ناس ڪرڻ لاءِ.","tokens":[{"surface":"ועתה","gloss":"۽ هاڻي"},{"surface":"כל","gloss":"سڀني"},{"surface":"נביאי","gloss":"نبين کي"},{"surface":"הבעל","gloss":"بعل جي"},{"surface":"כל","gloss":"سڀني"},{"surface":"עבדיו","gloss":"ٻانهن کي"},{"surface":"וכל","gloss":"۽ سڀني"},{"surface":"כהניו","gloss":"ڪاهنن کي"},{"surface":"קראו","gloss":"سڏيو"},{"surface":"אלי","gloss":"مون ڏانهن"},{"surface":"איש","gloss":"ماڻهو"},{"surface":"אל","gloss":"ڪونه"},{"surface":"יפקד","gloss":"رهي"},{"surface":"כי","gloss":"ڇوته"},{"surface":"זבח","gloss":"قربان"},{"surface":"גדול","gloss":"وڏو"},{"surface":"לי","gloss":"مان لاءِ"},{"surface":"לבעל","gloss":"بعل لاءِ"},{"surface":"כל","gloss":"جيڪو به"},{"surface":"אשר","gloss":"جيڪو"},{"surface":"יפקד","gloss":"ڪونه ايندو"},{"surface":"לא","gloss":"نه"},{"surface":"יחיה","gloss":"جيئرو رهندو"},{"surface":"ויהוא","gloss":"۽ ييهو"},{"surface":"עשה","gloss":"ڪري رهيو هو"},{"surface":"בעקבה","gloss":"چال سان"},{"surface":"למען","gloss":"لاءِ"},{"surface":"האביד","gloss":"ناس ڪرڻ"},{"surface":"את","gloss":"⟨את⟩","marks":"ٻانهن کي"},{"surface":"עבדי","gloss":"ٻانهن کي"},{"surface":"הבעל","gloss":"بعل جي"}],"timestamp":"2026-08-30T11:40:42.188384952Z","model":"glm-5.3"}